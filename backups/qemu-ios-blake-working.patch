+                                const char *old_prop, const char *new_prop, int depth)
+{
+    uint32_t nprops, nchildren;
+
+    if (depth > 32 || off + 8 > len) {
+        return 0;
+    }
+    nprops = ldl_le_p(dt + off);
+    nchildren = ldl_le_p(dt + off + 4);
+    off += 8;
+    for (uint32_t i = 0; i < nprops; i++) {
+        uint32_t plen;
+
+        if (off + 36 > len) {
+            return 0;
+        }
+        plen = ldl_le_p(dt + off + 32) & 0x7fffffff;
+        if (plen > len - off - 36) {
+            return 0;
+        }
+        if (!strncmp((char *)dt + off, old_prop, 32)) {
+            memset(dt + off, 0, 32);
+            strncpy((char *)dt + off, new_prop, 31);
+        }
+        off += 36 + ((plen + 3) & ~3u);
+    }
+    for (uint32_t i = 0; i < nchildren; i++) {
+        off = a4_dt_walk_rename(dt, len, off, old_prop, new_prop, depth + 1);
+        if (!off) {
+            return 0;
+        }
+    }
+    return off;
+}
