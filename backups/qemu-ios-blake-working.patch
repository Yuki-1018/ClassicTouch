+/*
+ * Walk Apple's flattened DeviceTree to locate and patch "secure-root-prefix".
+ * Stock restore DeviceTree ships secure-root-prefix = 'md' (for ramdisk boot).
+ * On normal boot root is 'disk0s1', which fails to match 'md', causing AppleARMPlatform
+ * to withhold the "SecureRoot" IOResource. Without SecureRoot, AppleEffaceableStorage
+ * refuses formatting ("format attempt from untrusted root"), blocking Keychain unlock
+ * and data migration on iOS 4.x.
+ * Patching secure-root-prefix to "disk" (or "d") restores SecureRoot publication
+ * and allows effaceable formatting and keybag generation on first boot.
+ */
+static size_t it_dt_walk_patch_secure_root(uint8_t *dt, size_t len, size_t off,
+                                           bool *patched, int depth)
+{
+    uint32_t nprops, nchildren;
+
+    if (depth > 32 || off + 8 > len) {
+        return 0;
+    }
+    nprops = ldl_le_p(dt + off);
+    nchildren = ldl_le_p(dt + off + 4);
+    off += 8;
+
+    for (uint32_t i = 0; i < nprops; i++) {
+        uint32_t plen;
+
+        if (off + 36 > len) {
+            return 0;
+        }
+        plen = ldl_le_p(dt + off + 32) & 0x7fffffff;
+        if (plen > len - off - 36) {
+            return 0;
+        }
+        if (!strncmp((char *)dt + off, "secure-root-prefix", 32)) {
+            uint8_t *slot = dt + off + 36;
+            fprintf(stderr, "[IT_DEVICETREE] Found secure-root-prefix: plen=%u, current='%.*s'\n",
+                    plen, (int)(plen < 32 ? plen : 32), (char *)slot);
+            if (plen >= 5) {
+                memset(slot, 0, plen);
+                memcpy(slot, "disk", 5);
+                *patched = true;
+            } else if (plen >= 4) {
+                memset(slot, 0, plen);
+                memcpy(slot, "disk", 4);
+                *patched = true;
+            } else if (plen >= 2) {
+                memset(slot, 0, plen);
+                memcpy(slot, "d", 2);
+                *patched = true;
+            }
+            if (*patched) {
+                fprintf(stderr, "[IT_DEVICETREE] Successfully patched secure-root-prefix to '%.*s'\n",
+                        (int)plen, (char *)slot);
+            }
+        }
+        off += 36 + ((plen + 3) & ~3u);
+    }
+
+    for (uint32_t i = 0; i < nchildren; i++) {
+        off = it_dt_walk_patch_secure_root(dt, len, off, patched, depth + 1);
+        if (!off) {
+            return 0;
+        }
+    }
+    return off;
+}
+
+static bool ipod_touch_patch_devicetree_in_ram(IPodTouchMachineState *nms)
+{
+    if (nms->devicetree_patched) {
+        return true;
+    }
+    if (!nms->boot_args_command_line) {
+        return false;
+    }
+    uint32_t boot_args_pa = nms->boot_args_command_line - 0x38;
+    uint8_t ba[0x38];
+    cpu_physical_memory_read(boot_args_pa, ba, sizeof(ba));
+
+    uint16_t rev = lduw_le_p(ba);
+    uint32_t vbase = ldl_le_p(ba + 4);
+    uint32_t pbase = ldl_le_p(ba + 8);
+    uint32_t dtp = ldl_le_p(ba + 0x30);
+    uint32_t dtlen = ldl_le_p(ba + 0x34);
+
+    if (rev != 1 || dtlen == 0 || dtlen > 0x200000 || dtp < vbase) {
+        return false;
+    }
+    uint32_t dt_pa = dtp - vbase + pbase;
+    if (dt_pa < 0x08000000 || dt_pa + dtlen > 0x10000000) {
+        return false;
+    }
+
+    g_autofree uint8_t *dt = g_try_malloc(dtlen);
+    if (!dt) {
+        return false;
+    }
+    cpu_physical_memory_read(dt_pa, dt, dtlen);
+
+    uint32_t nprops = ldl_le_p(dt);
+    uint32_t nchildren = ldl_le_p(dt + 4);
+    if (nprops == 0 && nchildren == 0) {
+        return false;
+    }
+    if (nprops > 500 || nchildren > 500) {
+        return false;
+    }
+
+    bool patched = false;
+    it_dt_walk_patch_secure_root(dt, dtlen, 0, &patched, 0);
+    if (patched) {
+        cpu_physical_memory_write(dt_pa, dt, dtlen);
+        nms->devicetree_patched = true;
+        fprintf(stderr, "[IT_DEVICETREE] Successfully wrote patched DeviceTree to DRAM at 0x%08x (len %u)!\n",
+                dt_pa, dtlen);
+        return true;
+    }
+    return false;
+}
+
+static void ipod_touch_dt_patch_timer_cb(void *opaque)
+{
+    IPodTouchMachineState *nms = (IPodTouchMachineState *)opaque;
+    if (nms->devicetree_patched) {
+        return;
+    }
+    if (!nms->boot_args_format) {
+        g_autofree uint8_t *image = g_try_malloc(IBOOT_SCAN_LEN);
+        if (image) {
+            cpu_physical_memory_read(IBOOT_SCAN_PA_START, image, IBOOT_SCAN_LEN);
+            nms->boot_args_format = it_iboot_find_boot_args_format(
+                image, IBOOT_SCAN_LEN, IBOOT_SCAN_PA_START, &nms->boot_args_command_line);
+        }
+    }
+    if (nms->boot_args_command_line && ipod_touch_patch_devicetree_in_ram(nms)) {
+        return;
+    }
+    /* Re-arm timer to check again in 10 ms (up to ~60 seconds of virtual time) */
+    if (qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) < 60000) {
+        timer_mod(nms->dt_patch_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 10);
+    }
+}
