+        return false;
+    }
+    va = s->pipe[0].regs[(DP_UI_BASE(0) + DP_UI_ADDR) / 4];
+    if (!va) {
+        va = (uint32_t)s->fb_base;
+    }
+    if (!va) {
+        return false;
+    }
+    va += y * row_bytes;
+    while (done < row_bytes) {
+        uint32_t n = MIN(row_bytes - done, 0x1000u - (va & 0xfffu));
+        hwaddr pa = dart_xlate(s, va);
+        if (pa != (hwaddr)-1) {
+            address_space_write(&address_space_memory, pa,
+                                MEMTXATTRS_UNSPECIFIED, row_bgra + done, n);
+        }
+        va += n;
+        done += n;
+    }
+    return true;
+}
+
+bool s5l8930_display_gles_read_panel(uint8_t *out, uint32_t w, uint32_t h)
+{
+    S5L8930DisplayState *s = s5l8930_display_find();
+    uint32_t *r;
+    uint32_t va = 0;
+
+    if (!s || !out || !w || !h) {
+        return false;
+    }
+    r = s->pipe[0].regs;
+    if ((r[DP_LAYERS / 4] & 0x200) && r[(DP_UI_BASE(1) + DP_UI_ADDR) / 4]) {
+        va = r[(DP_UI_BASE(1) + DP_UI_ADDR) / 4];
+    } else if (r[(DP_UI_BASE(0) + DP_UI_ADDR) / 4]) {
+        va = r[(DP_UI_BASE(0) + DP_UI_ADDR) / 4];
+    } else {
+        va = (uint32_t)s->fb_base;
+    }
+    if (!va) {
+        return false;
+    }
+    fb_read(s, va, out, w * h * 4);
+    return true;
+}
