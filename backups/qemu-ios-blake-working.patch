+/*
+ * Real AppleEffaceableNOR writes a volume header and entries into the NOR's
+ * effaceable sectors (such as 0xFA000/0xFB000 or board-specific sectors in 4.0).
+ * Scan the entire 1 MiB NOR so any formatted sector/layout is detected, while
+ * ignoring a completely blank (all 0xFF) image or a legacy 4-byte 'kL' stub.
+ */
+bool a4_nor_has_effaceable(const char *path)
+{
+    FILE *f;
+    uint8_t buf[4096];
+    size_t non_ff = 0;
+
+    if (!path || !path[0]) {
+        return false;
+    }
+    f = fopen(path, "rb");
+    if (!f) {
+        return false;
+    }
+    for (;;) {
+        size_t n = fread(buf, 1, sizeof(buf), f);
+        if (n == 0) {
+            break;
+        }
+        for (size_t i = 0; i < n; i++) {
+            if (buf[i] != 0xFF) {
+                if (++non_ff >= 16) {
+                    fclose(f);
+                    return true;
+                }
+            }
+        }
+    }
+    fclose(f);
+    if (non_ff > 0) {
+        fprintf(stderr, "[nor-check] %s has only %zu non-0xFF bytes (<16)\n", path, non_ff);
+    }
+    return false;
+}
