+void a4_dt_rename_prop(uint8_t *image, size_t image_len, uint32_t load_pa,
+                       uint32_t bootargs_pa, const char *old_prop, const char *new_prop)
+{
+    size_t ba = bootargs_pa - load_pa, dt;
