+// even when imported from an older prepared base or an existing container's state/nor.bin.
+static void ensure_s5l8900_nor_nvram(const fs::path &nor_path) {
+    if (!fs::is_regular_file(nor_path))
+        return;
+    std::string raw = read_file(nor_path, 0x100001u);
+    if (raw.size() != 0x100000u)
+        return;
+
+    constexpr size_t kNvramBase = 0xFC000u;
+    constexpr size_t kBankSize = 0x2000u;
+    bool file_changed = false;
+
