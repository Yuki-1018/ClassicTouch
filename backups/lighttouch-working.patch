+        std::string joined;
+        for (int i = 0; i < argc; ++i) joined += std::string(argv[i]) + "\n";
+        assert(joined.find("cross-page-chain=on") == std::string::npos);
+        assert(joined.find("indirect-cache=on") == std::string::npos);
+        std::string repaired = [&] {
+            std::ifstream f(root / "m68state/nor.bin", std::ios::binary);
+            return std::string((std::istreambuf_iterator<char>(f)), {});
