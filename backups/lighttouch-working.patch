+        ed.write("usr/share/zoneinfo/Asia/Tokyo", b"TZif2".to_vec(), None).unwrap();
+        ed.write("usr/share/zoneinfo/Asia/Calcutta", b"TZif2".to_vec(), None).unwrap();
+        ed.mkdirs("usr/share/zoneinfo/Etc").unwrap();
+        ed.write("usr/share/zoneinfo/Etc/GMT", b"TZif2".to_vec(), None).unwrap();
+
+        assert_eq!(resolve_timezone(&ed, ":Asia/Tokyo").as_deref(), Some("Asia/Tokyo"));
+        assert_eq!(resolve_timezone(&ed, "Asia/Kolkata").as_deref(), Some("Asia/Calcutta"));
+        assert_eq!(resolve_timezone(&ed, "Mars/Olympus").as_deref(), Some("Etc/GMT"));
+        assert_eq!(resolve_timezone(&ed, "../etc/passwd"), None);
+
+        // 1.x uses db/localtime
+        let p1 = seed_timezone(&mut ed, "private/var", "Asia/Tokyo", 1).unwrap();
+        assert!(p1.contains(&"private/var/db/localtime".to_string()));
+        assert_eq!(ed.read_link("private/var/db/localtime").unwrap(), "/usr/share/zoneinfo/Asia/Tokyo");
+
+        // 2.x+ uses db/timezone/localtime
+        ed.mkdirs("db/timezone").unwrap();
+        ed.write("db/timezone/localtime", b"old-file".to_vec(), None).unwrap();
+        let p2 = seed_timezone(&mut ed, "", "America/New_York", 6).unwrap();
+        assert!(p2.contains(&"db/timezone/localtime".to_string()));
+        assert_eq!(ed.read_link("db/timezone/localtime").unwrap(), "/usr/share/zoneinfo/America/New_York");
+    }
 }
