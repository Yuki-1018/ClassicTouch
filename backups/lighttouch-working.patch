+        uint8_t *bank = reinterpret_cast<uint8_t *>(&raw[kNvramBase + b * kBankSize]);
+        if (bank[0] != 0x5Au || memcmp(bank + 4, "nvram", 5) != 0)
+            continue;
+        if (bank[0x20] != 0x70 || memcmp(bank + 0x24, "common", 6) != 0)
+            continue;
+        const size_t common_len = (size_t(bank[0x22]) | (size_t(bank[0x23]) << 8)) * 16u;
+        if (common_len <= 16u || 0x20u + common_len > kBankSize)
+            continue;
+
+        std::vector<std::pair<std::string, std::string>> entries;
+        const char *cur = reinterpret_cast<const char *>(bank + 0x30);
+        const char *end = reinterpret_cast<const char *>(bank + 0x20 + common_len);
+        while (cur < end && *cur != '\0') {
+            const char *nul = static_cast<const char *>(memchr(cur, '\0', size_t(end - cur)));
+            const size_t slen = nul ? size_t(nul - cur) : size_t(end - cur);
+            std::string item(cur, slen);
+            const size_t eq = item.find('=');
+            if (eq != std::string::npos) {
+                std::string k = item.substr(0, eq), v = item.substr(eq + 1);
+                auto it = std::find_if(entries.begin(), entries.end(), [&](const auto &p) { return p.first == k; });
+                if (it == entries.end())
+                    entries.emplace_back(std::move(k), std::move(v));
+                else
+                    it->second = std::move(v);
+            }
+            cur += slen + (nul ? 1u : 0u);
+        }
+
+        auto ensure_kv = [&](const char *k, const char *v, bool overwrite_if_different) {
+            auto it = std::find_if(entries.begin(), entries.end(), [&](const auto &p) { return p.first == k; });
+            if (it == entries.end()) {
+                entries.emplace_back(k, v);
+                return true;
+            }
+            if (overwrite_if_different && it->second != v) {
+                it->second = v;
+                return true;
+            }
+            return false;
+        };
+
+        bool bank_changed = false;
+        bank_changed |= ensure_kv("auto-boot", "true", true);
+        bank_changed |= ensure_kv("boot-command", "fsboot", false);
+        bank_changed |= ensure_kv("debug-uarts", "3", true);
