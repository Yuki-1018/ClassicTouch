+static uint32_t nvram_adler32(const uint8_t *data, size_t len) {
+    uint32_t a = 1, b = 0;
+    for (size_t i = 0; i < len; ++i) {
+        a = (a + data[i]) % 65521u;
+        b = (b + a) % 65521u;
+    }
+    return (b << 16) | a;
+}
+
+static uint8_t chrp_header_checksum(const uint8_t *h) {
+    uint32_t s = h[0];
+    for (size_t i = 2; i < 16; ++i) {
+        s += h[i];
+        if (s > 0xFFu)
+            s = (s & 0xFFu) + 1u;
+    }
+    return uint8_t(s);
+}
