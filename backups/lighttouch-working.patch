+        memset(bank + 0x30, 0, common_len - 16u);
+        memcpy(bank + 0x30, body.data(), body.size());
+        if (bank[0x14] == 0 && bank[0x15] == 0 && bank[0x16] == 0 && bank[0x17] == 0)
