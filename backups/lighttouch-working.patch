+fn zone_aliases(name: &str) -> &'static [&'static str] {
+    match name {
+        "Asia/Kolkata" => &["Asia/Calcutta"],
+        "Asia/Ho_Chi_Minh" => &["Asia/Saigon"],
+        "Asia/Yangon" => &["Asia/Rangoon"],
+        "Asia/Kathmandu" => &["Asia/Katmandu"],
+        "Europe/Kyiv" => &["Europe/Kiev"],
+        "America/Argentina/Buenos_Aires" => &["America/Buenos_Aires"],
+        "America/Nuuk" => &["America/Godthab"],
+        "UTC" => &["Etc/UTC", "GMT", "Etc/GMT"],
+        "Etc/UTC" => &["UTC", "GMT", "Etc/GMT"],
+        _ => &[],
+    }
+}
+
+/// Resolve a candidate IANA timezone name (e.g. `"Asia/Tokyo"`) against `system`'s `/usr/share/zoneinfo`.
+/// Falls back to known legacy aliases or `Etc/GMT`/`GMT` when the firmware ships unpacked zone files and
+/// lacks the requested name. Returns `None` if `raw` is empty or invalid.
+pub fn resolve_timezone(system: &Editor, raw: &str) -> Option<String> {
+    let trimmed = raw.trim().trim_start_matches(':');
+    if trimmed.is_empty() || trimmed.starts_with('/') || trimmed.contains("..") {
+        return None;
+    }
+    let has_zone_files = system.exists("usr/share/zoneinfo/GMT")
+        || system.exists("usr/share/zoneinfo/Etc/GMT")
+        || system.exists("usr/share/zoneinfo/Asia")
+        || system.exists("usr/share/zoneinfo/America");
+    if !has_zone_files {
+        return Some(trimmed.to_string());
+    }
+    if system.exists(&format!("usr/share/zoneinfo/{trimmed}")) {
+        return Some(trimmed.to_string());
+    }
+    for alias in zone_aliases(trimmed) {
+        if system.exists(&format!("usr/share/zoneinfo/{alias}")) {
+            return Some((*alias).to_string());
+        }
+    }
+    for fallback in ["Etc/GMT", "GMT"] {
+        if system.exists(&format!("usr/share/zoneinfo/{fallback}")) {
+            return Some(fallback.to_string());
+        }
+    }
+    Some(trimmed.to_string())
+}
+
+/// Write a timezone symlink at `var_root/<rel>` replacing any pre-existing file or symlink, returning
+/// created parent directory (if new) and link paths for owner fixup.
+fn write_zone_symlink(data: &mut Editor, rel: &str, target: &str) -> Result<Vec<String>> {
+    let mut created = Vec::new();
+    if let Some((parent, _)) = rel.rsplit_once('/') {
+        if !data.exists(parent) {
+            data.mkdirs(parent)?;
+            created.push(parent.to_string());
+        }
+    }
+    if data.lstat(rel)?.is_some() {
+        data.remove(rel)?;
+    }
+    data.symlink(rel, target)?;
+    created.push(rel.to_string());
+    Ok(created)
+}
+
+/// Seeds the guest localtime symlink (`/var/db/localtime` on 1.x, `/var/db/timezone/localtime` on 2.x+)
+/// pointing to `/usr/share/zoneinfo/<tz>`, returning the modified HFS paths for ownership fixup.
+pub fn seed_timezone(data: &mut Editor, var_root: &str, tz: &str, major: u32) -> Result<Vec<String>> {
+    let tz = tz.trim().trim_start_matches(':');
+    if tz.is_empty() {
+        return Ok(Vec::new());
+    }
+    let target = format!("/usr/share/zoneinfo/{tz}");
+    let (primary, secondary) = if major <= 1 {
+        ("db/localtime", "db/timezone/localtime")
+    } else {
+        ("db/timezone/localtime", "db/localtime")
+    };
+    let mut touched = write_zone_symlink(data, &join(var_root, primary), &target)?;
+    let alt = join(var_root, secondary);
+    if data.lstat(&alt)?.is_some() {
+        touched.extend(write_zone_symlink(data, &alt, &target)?);
+    }
+    Ok(touched)
+}
