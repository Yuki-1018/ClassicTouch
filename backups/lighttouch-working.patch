+            std::string common(&repaired[off + 0x30], 0x400);
+            assert(common.find("boot-args=rd=disk0s1 serial=1") != std::string::npos);
+            assert(common.find("wifiaddr=02:11:22:33:44:55") != std::string::npos);
+            assert(common.find("debug-uarts=3") != std::string::npos);
+            assert(common.find("auto-boot=true") != std::string::npos);
