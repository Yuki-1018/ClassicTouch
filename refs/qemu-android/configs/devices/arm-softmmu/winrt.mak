# Windows RT ARMv7 (ARM virt + platform EHCI/OHCI/SDHCI + PCI VGA)
CONFIG_ARM_VIRT=y
CONFIG_VGA_PCI=y
CONFIG_USB_EHCI_SYSBUS=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_SYSBUS=y
CONFIG_USB_OHCI_PCI=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE_CLASSIC=y
CONFIG_USB_STORAGE_BOT=y
CONFIG_USB_NETWORK=y
CONFIG_USB_AUDIO=y
CONFIG_SDHCI=y

# OpenHarmony ARMv7 (ARM virt + VirtIO PCI/MMIO GPU/Input/Blk/Net/RNG + ES1370 audio)
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_GPU=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_RNG=y
CONFIG_ES1370=y
